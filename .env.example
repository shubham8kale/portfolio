# Server-side only — set these in Vercel project settings (and .env.local for dev).
# NEVER prefix any of these with NEXT_PUBLIC_.

# Groq API key (console.groq.com). Without it /api/chat returns a friendly 503.
GROQ_API_KEY=

# Optional model override; defaults to openai/gpt-oss-120b.
# Check console.groq.com/docs/models for the current catalog.
GROQ_MODEL=

# Upstash Redis (console.upstash.com, free tier) — rate limiting.
# Without these the bot still works but is unlimited (Groq quota is the only bound).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The same Redis also stores the chat question log (questions + answers, no
# IPs or other identifiers) that /admin/chat displays.

# Secret for the daily Vercel cron that keeps the free Upstash database from
# being deleted after 14 idle days (/api/keepalive, scheduled in vercel.json).
# Vercel sends it automatically as a Bearer token. Any long random string.
CRON_SECRET=

# Password for /admin/chat (HTTP Basic auth; any username). Unset = /admin 404s.
ADMIN_PASSWORD=

# Public site URL used for metadata/sitemap (safe to expose).
NEXT_PUBLIC_SITE_URL=
